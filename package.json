{
  "name": "mailbrief",
  "version": "0.1.0",
  "private": true,
  "description": "User-triggered attachment summaries for Gmail and Outlook Web (Chrome MV3).",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "build": "vite build && vite build -c vite.content.config.ts",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run package"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "archiver": "^8.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.2",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
